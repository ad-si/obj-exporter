{
  "name": "obj-exporter",
  "version": "0.2.0",
  "description": "Export face-vertex and polygon meshes to the OBJ format",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "obj-exporter": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/index.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@adius/yaml2json": "^0.1.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adius/obj-exporter.git"
  },
  "keywords": [
    "OBJ",
    "mesh",
    "3d",
    "exporter",
    "wavefront"
  ],
  "author": "Adrian Sieber",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adius/obj-exporter/issues"
  },
  "homepage": "https://github.com/adius/obj-exporter#readme"
}
